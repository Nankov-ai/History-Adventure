%% History Adventure — arquitetura da app (5º ano, Portugal)
%% Espelha a estrutura estática do "English Adventure": sem build, sem servidor.

flowchart TD
    subgraph Fontes["📚 Fontes do Conhecimento (input humano)"]
        F1[Manual / fichas / PDFs de História<br/>5º ano]
    end

    subgraph Static["🖥️ App estática (HTML/CSS/JS puro)"]
        HTML[index.html<br/>Shell: seletor de época + separadores de jogos]
        DATA[data.js<br/>Fonte única de verdade:<br/>épocas, perguntas, vocabulário, datas]
        IMAGES[images.js<br/>Linhas do tempo, mapas, cenas visuais em HTML/CSS]
        APP[app.js<br/>Lógica dos jogos, lê gameData via td()]
        CSS[styles.css<br/>Estilo, sem pré-processador]
    end

    subgraph Games["🎮 Jogos (todas as unidades)"]
        G1[🎯 Associar<br/>imagem/palavra ↔ conceito]
        G2[❓ Quiz<br/>perguntas de escolha múltipla]
        G3[🔤 Ordenar Letras<br/>reconstruir palavras-chave]
        G4[📜 Completar Frase<br/>preencher espaços em textos históricos]
    end

    subgraph GamesHist["🎮 Jogos (só unidades de História B1-C3)"]
        G5[🕰️ Linha do Tempo<br/>ordenar acontecimentos cronologicamente]
    end

    subgraph GamesGeo["🎮 Jogos (só unidades de Geografia A1-A2)"]
        G6[🗺️ Legendar o Mapa<br/>título / legenda / fonte / orientação / escala]
    end

    subgraph Topics["🏛️ Unidades (HGP em Ação 5 — Porto Editora)"]
        T1["A1/A2 · Península Ibérica<br/>Localização + Quadro Natural"]
        T2["B1 · Primeiras comunidades<br/>humanas da Península"]
        T3["B2 · Os Romanos na<br/>Península Ibérica"]
        T4["B3 · Os Muçulmanos na<br/>Península Ibérica"]
        T5["B4 · Formação do<br/>Reino de Portugal"]
        T6["C1 · Portugal séc. XIII-XIV"]
        T7["C2 · Portugal séc. XV-XVI<br/>(Expansão Marítima)"]
        T8["C3 · União Ibérica →<br/>Restauração da Independência"]
    end

    F1 -->|"extração manual/assistida<br/>de conteúdos e imagens"| DATA
    F1 -.->|"referências de página<br/>📖 p.XX"| DATA

    DATA --> APP
    IMAGES --> APP
    APP --> HTML
    CSS --> HTML

    APP --> G1
    APP --> G2
    APP --> G3
    APP --> G4
    APP --> G5
    APP --> G6

    Topics -.->|"A1-A2: 4 jogos comuns + Legendar Mapa"| GamesGeo
    Topics -.->|"B1-C3: 4 jogos comuns + Linha do Tempo"| GamesHist

    HTML -->|"score em localStorage<br/>chave: ha_highScore"| Score[(Pontuação local)]

    Static -->|"git push origin main"| Deploy[GitHub Pages<br/>deploy automático]
    Deploy --> User((Aluno 5º ano))
